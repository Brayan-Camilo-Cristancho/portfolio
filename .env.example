# Copy this file to .env.local and fill in the values.
# In production, set the same variables in Vercel: Project Settings > Environment Variables.

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# The site key is public and is bundled into the client, hence the VITE_ prefix.
VITE_TURNSTILE_SITE_KEY=
# The secret key is server-only. Leave empty in development to use Cloudflare's test key.
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com/api-keys)
# Leave empty in development: the API validates the message and logs it instead of sending.
RESEND_API_KEY=
# Inbox that receives the messages.
CONTACT_TO_EMAIL=
# Sender. Must belong to a domain verified in Resend; onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
